---
// Page shell: head SEO + header + main slot + footer. Used by every page.
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { organizationLd, websiteLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any>[];
}
const { title, description, path, ogImage, noindex, jsonLd = [] } = Astro.props;
const ld = [organizationLd(), websiteLd(), ...jsonLd];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      noindex={noindex}
      jsonLd={ld}
    />
    {/* Almanac funnel beacon. Fire-and-forget GETs to the fulfilment Worker; it never
        blocks navigation and it sends nothing but an event name, a lake slug and a
        placement token. The Worker only counts hits whose Referer is this site. */}
    <script is:inline>
      (function () {
        var B = 'https://lake-level-almanac.lipmichal.workers.dev/hit';
        var ok = /^[a-z0-9-]{0,40}$/;
        function tok(v) { v = String(v || ''); return ok.test(v) ? v : ''; }
        function hit(e, l, p) {
          var u = B + '?e=' + e + '&l=' + tok(l) + '&p=' + tok(p);
          try { fetch(u, { method: 'GET', keepalive: true, mode: 'no-cors' }).catch(function () {}); }
          catch (_) { /* no fetch: the hit is dropped, the page is not */ }
        }
        window.__almHit = hit;
        var path = location.pathname.replace(/\/+$/, '');
        if (path === '/almanac') hit('alm_view', '', '');
        if (path === '/almanac/thanks') hit('thanks_view', '', '');
        document.addEventListener('click', function (ev) {
          var t = ev.target; if (!t || !t.closest) return;
          var w = t.closest('[data-alm-place]');
          var p = w ? w.getAttribute('data-alm-place') : '';
          var pick = t.closest('a[data-alm-pick]');
          if (pick) { hit('cta_click', 'single', pick.getAttribute('data-alm-pick')); return; }
          var a = t.closest('a[data-alm-buy],a[data-alm-cta],.alm-home-btn');
          if (!a || (a.getAttribute('href') || '').indexOf('https://buy.stripe.com') !== 0) return;
          var m = /client_reference_id=([a-z0-9-]{1,40})/.exec(a.href);
          hit('checkout_open', a.getAttribute('data-lake') || (m ? m[1] : 'bundle'), p);
        }, true);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  
<!-- Empire: related calculators (topically relevant sibling tools) -->
<section class="empire-related" aria-label="Related calculators" style="max-width:760px;margin:48px auto 64px;padding:24px 28px;border:1px solid #e3e6ec;border-radius:14px;background:#fafbfc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2933">
  <h2 style="margin:0 0 10px;font-size:18px;font-weight:700;letter-spacing:-.01em">Related calculators</h2>
  <p style="margin:0 0 14px;font-size:14px;color:#52606d">More free tools from our network: live lake & reservoir water levels and beyond.</p>
  <ul style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:8px 18px;font-size:14px">
      <li><a href="https://earlythunder.com/">storm & severe-weather tracker</a></li>
      <li><a href="https://examscorecalc.com/">grade & test-score calculator</a></li>
  </ul>
</section>
<!-- /Empire -->

</body>
</html>
